# Shared .env for both EduAvatars deploy paths (see README.md).
# Copy this file to .env and fill in the values below:
#   cp .env.example .env
#
# Generate the two required secrets:
#   JWT_SECRET:                python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   API_KEY_ENCRYPTION_SECRET: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# All variables *not* set in this file (database path, upload folders, JWT algorithm/expiry, 
# STT model, ...) have sensible defaults for local development 
# — see backend/app/core/config.py for the full list. 
# Deploy B additionally hardcodes some of these directly in docker-compose.yml's
# `environment:` block for production, which always takes priority over this file.

# --- Required, no default ---
JWT_SECRET=change-me
API_KEY_ENCRYPTION_SECRET=change-me


# --- Used by both deploy paths ---
# For local development, the defaults below (matching the Vite dev server) are fine as-is.
# In production (Deploy B), set both to "https://" + your domain — same domain as SITE_ADDRESS.
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Variables for Deploy B (Docker) only — Deploy A ignores these ---
# Public domain, without "https://". Used by Caddy (see docker/Caddyfile) to match the incoming
# Host header — if something in front of Caddy (e.g. an institutional reverse proxy) forwards a
# different Host header than this, Caddy won't match any site and the request fails.
# SITE_ADDRESS=your-domain.example
#
# Absolute host path for the SQLite DB, uploads, and the STT model cache (bind-mounted to
# /data — see docker/docker-compose.yml). Must be writable by the backend container's app user —
# see PUID/PGID below.
# EDUAVATARS_DATA_DIR=/path/to/eduavatars-data
#
# Which hops in front of the backend may report the real visitor address via X-Forwarded-For.
# The default covers the private networks Caddy (and cloudflared, if containerised) sit on, which
# is what a standard Compose setup needs — only set this if your proxy reaches the backend from
# somewhere else, e.g. cloudflared running directly on the host. Getting it wrong doesn't break
# the app, it just makes every visitor look like the proxy, so the per-IP rate limits in
# backend/app/core/rate_limit.py all collapse into one shared bucket. Never set it to "*" — see
# the comment in docker/docker-compose.yml.
#
# Sitting behind an ADDITIONAL reverse proxy in front of Caddy (e.g. an institution's own nginx)?
# That proxy's address needs adding here too, not just Caddy's — every hop that appends itself to
# X-Forwarded-For has to be trusted, or the outer proxy's own address gets mistaken for the
# visitor's. See docker/README.md's "Deploying behind another reverse proxy" section.
# FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
#
# UID/GID the backend container's app user runs as — the entrypoint adjusts the in-container user
# to match at startup (see docker/backend-entrypoint.sh), so EDUAVATARS_DATA_DIR just needs to be
# writable by this UID/GID, whatever it is. Default (568/568) matches TrueNAS SCALE's built-in
# "apps" user, so on TrueNAS you don't need to set these at all. On any other host, set both to the
# UID/GID that should own EDUAVATARS_DATA_DIR (e.g. `id -u`/`id -g` of your own user).
# PUID=568
# PGID=568


# --- Optional, both deploy paths (password-reset emails via SMTP) ---
# Without SMTP_HOST, the reset flow is a silent no-op (see
# backend/app/services/email_service.py) — fine for local dev, required for production.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@eduavatars.example

# --- Optional, both deploy paths (on-device speech-to-text via WebGPU) ---
# Voice input is transcribed on the visitor's own device by default (Parakeet Redux, see
# backend/app/core/config.py's "BROWSER SPEECH-TO-TEXT" section), from model files this deployment
# hosts itself (downloaded automatically by Docker Compose, see docker/README.md). Set to false to
# transcribe everything on the server instead (e.g. before the model files are in place).
# BROWSER_STT_ENABLED=false
# BROWSER_STT_MODEL_URL=/models/parakeet-redux/v1/

# --- Optional, both deploy paths (server-side speech-to-text engine) ---
# Voice messages that aren't transcribed on the visitor's device (no WebGPU, or the project opted
# out) are transcribed on the server, with faster-whisper by default. "parakeet" uses the same
# Parakeet Redux model as the browsers instead: about twice as fast on the CPU and at least as
# accurate on German, but without a language hint (see backend/app/core/config.py). It reuses the
# model files above, and falls back to Whisper while they're missing.
# STT_ENGINE=parakeet

# --- Optional, both deploy paths (local text-to-speech and voice cloning) ---
# Speech output without a cloud TTS key, including voices cloned from teachers' own clips
# (Dashboard → Voices). Docker: also set COMPOSE_PROFILES=local-tts so the tts-local service
# starts (see docker/README.md). Local dev: run local-tts/ by hand and point LOCAL_TTS_URL at it.
# LOCAL_TTS_ENABLED=true
# COMPOSE_PROFILES=local-tts
# LOCAL_TTS_URL=http://127.0.0.1:8080

# --- Optional, both deploy paths (knowledge bases / RAG) ---
# Teachers upload their own documents (Dashboard → Knowledge) and projects answer from them, with
# any LLM provider. Runs as the separate knowledge service in rag/ (see rag/README.md). Docker:
# add "rag" to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=local-tts,rag) so the rag service starts —
# see docker/README.md. Local dev: run rag/ by hand and point RAG_SERVICE_URL at it.
# RAG_ENABLED=true
# RAG_SERVICE_TOKEN=          # same value for backend and knowledge service; generate with
#                             # python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# RAG_SERVICE_URL=http://127.0.0.1:8090   # local dev only; Docker uses http://rag:8090
# RAG_QUERY_TIMEOUT_MS=1500   # retrieval budget per chat turn; past it, the avatar answers without
#                             # the material instead of keeping the student waiting
#
# Better parsing of tables, columns and scans (Docker: COMPOSE_PROFILES=rag,docling):
# DOCLING_URL=http://docling:5001
#
# Knowledge service ceilings for the upload limits an admin sets in the dashboard
# (Admin → Settings) — see rag/README.md for the rest of its settings:
# RAG_HARD_MAX_UPLOAD_MB=100
# RAG_HARD_MAX_PAGES=2000

# --- Optional, both deploy paths (creates/promotes your first admin account) ---
# Set both to create-or-promote this account to admin on startup (see
# backend/app/cli/bootstrap_admin.py) — the resulting account manages other accounts and site
# settings from /dashboard/admin. Safe to remove after the first successful run, or to leave set
# indefinitely (it's a no-op once the account is already an admin). Without these, the instance
# starts with no admin at all — promote someone by hand (see backend/README.md) or set these and
# restart.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

