# SITE_ADDRESS comes from .env (see docker-compose.yml) instead of being hardcoded in the image, so
# the same image works both for a real production host and for a local test run
# (SITE_ADDRESS=localhost).
#
# auto_https off: TLS isn't handled by Caddy itself, it's terminated by the Cloudflare Tunnel
# (cloudflared) in front of it — Caddy is never directly reachable from the outside, so its own
# Let's Encrypt attempt via HTTP-01 would fail anyway. The tunnel talks to Caddy over plain HTTP
# instead.
{
	auto_https off
}

http://{$SITE_ADDRESS} {
	# Applies to every response below (SPA pages and proxied API alike) — neither the public chat
	# nor the dashboard had any clickjacking/MIME-sniffing protection at any layer before this.
	# No Content-Security-Policy here on purpose: three.js/WebGL avatar rendering, blob: audio
	# playback, and the Tally survey iframe (components/SurveyEmbed) would all need a carefully
	# tuned policy that's genuinely at risk of silently breaking the avatar for every visitor if
	# it's wrong — that needs real browser testing, not a guess, so it's deliberately left for a
	# dedicated follow-up instead of shipped un-verified here.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Harmless if a deployment somehow serves plain HTTP end-to-end: browsers only ever honor
		# this header on a response they received over an actual HTTPS connection (RFC 6797) — it
		# only does anything once the documented Cloudflare Tunnel (or equivalent) is in place.
		Strict-Transport-Security "max-age=15552000"
	}

	# Explicit content-type allowlist instead of Caddy's own default: the streamed chat reply
	# (backend/app/api/public_chat.py::send_message_stream, Content-Type: text/event-stream)
	# must NOT be gzip-encoded — it's already base64 audio (barely compressible) sent as a long-
	# lived stream, and holding a compression buffer open across it just burns CPU per student
	# for no space saved.
	encode gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	# Backend routes are mounted without an /api prefix (e.g. /auth/login, not /api/auth/login, see
	# backend/app/main.py) — same rewrite as locally in frontend/vite.config.ts.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	# Also reachable at the bare path, not just /api/health — the URL an external load balancer
	# or monitoring/uptime check would naturally try first. Without this it falls through to the
	# SPA handle below and gets a false "200 OK" from index.html instead of the backend's actual
	# health status, even while the backend container is fully down.
	handle /health {
		reverse_proxy backend:8000
	}

	# SPA fallback: a direct request for e.g. /c/some-slug still needs to serve index.html, otherwise
	# reloading on a sub-route would be a 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
