# react-i18next's peer dependency range (typescript ^5) hasn't caught up to TypeScript 7 yet,
# which this project pins deliberately — the mismatch is a stale peer-dep range, not an actual
# incompatibility. Without this, npm's default strict peer-dependency resolution makes `npm ci`
# fail with an ERESOLVE error (see docker/frontend.Dockerfile, which runs plain `npm ci`).
legacy-peer-deps=true
